#!/usr/bin/env python3
"""Create a CUPS queue for an Aimotech D30 (Print Master).

Needs the lpadmin group (or root), not a per-job sudo. After the queue
exists, anyone the CUPS print policy allows can lp/lpr.

  aimotech-setup-printer --list
  aimotech-setup-printer --mac 01:23:45:67:89:AB
  aimotech-setup-printer              # unique discovered D30
"""

from __future__ import annotations

import argparse
import grp
import os
import pwd
import subprocess
import sys
from pathlib import Path

DRV_MODEL = "drv:///aimotech.drv/aimotechd30.ppd"
PPD_PATH = "/usr/share/ppd/aimotech/Aimotech_D30.ppd"
LPADMIN = "/usr/sbin/lpadmin"
LPINFO = "/usr/sbin/lpinfo"
DEFAULT_NAME = "AimotechD30"


def _ensure_share_path() -> None:
    here = Path(__file__).resolve().parent
    for path in (here, here.parent, Path("/usr/share/printer-driver-aimotech")):
        if path.is_dir() and str(path) not in sys.path:
            sys.path.insert(0, str(path))


def _load_aimotech_bt():
    _ensure_share_path()
    import aimotech_bt

    return aimotech_bt


aimotech_bt = _load_aimotech_bt()


def in_lpadmin() -> bool:
    if os.geteuid() == 0:
        return True
    try:
        wanted = grp.getgrnam("lpadmin").gr_gid
    except KeyError:
        return False
    user = pwd.getpwuid(os.geteuid()).pw_name
    return wanted in os.getgrouplist(user, os.getgid())


def lpinfo_aimotech() -> list[tuple[str, str]]:
    if not Path(LPINFO).is_file():
        return []
    try:
        proc = subprocess.run(
            [LPINFO, "-v"],
            capture_output=True,
            text=True,
            timeout=20,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return []
    found: list[tuple[str, str]] = []
    for raw in (proc.stdout or "").splitlines():
        line = raw.strip()
        if not line.startswith("direct aimotech://"):
            continue
        uri = line.split(None, 2)[1]
        try:
            addr = aimotech_bt.parse_uri(uri)
        except ValueError:
            continue
        name = "D30"
        if '"' in line:
            bits = line.split('"')
            if len(bits) >= 2:
                name = bits[1].replace("Aimotech ", "", 1).strip() or "D30"
        found.append((addr, name))
    return found


def discover() -> list[tuple[str, str]]:
    via_cups = lpinfo_aimotech()
    if via_cups:
        return via_cups
    return aimotech_bt.list_bluez_devices()


def add_queue(name: str, addr: str, *, dry_run: bool) -> int:
    uri = f"aimotech://{addr}"
    if dry_run:
        print(f"{LPADMIN} -p {name} -E -v {uri} -m {DRV_MODEL}")
        return 0
    if not in_lpadmin():
        print(
            "aimotech-setup-printer: join the lpadmin group (or run as root) to add a queue",
            file=sys.stderr,
        )
        return 4
    if not Path(LPADMIN).is_file():
        print("aimotech-setup-printer: lpadmin missing; install cups", file=sys.stderr)
        return 1
    cmd = [LPADMIN, "-p", name, "-E", "-v", uri, "-m", DRV_MODEL]
    proc = subprocess.run(cmd, capture_output=True, text=True, check=False)
    if proc.returncode != 0 and Path(PPD_PATH).is_file():
        cmd = [LPADMIN, "-p", name, "-E", "-v", uri, "-P", PPD_PATH]
        proc = subprocess.run(cmd, capture_output=True, text=True, check=False)
    if proc.returncode != 0:
        err = (proc.stderr or proc.stdout or "").strip()
        print(f"aimotech-setup-printer: lpadmin failed: {err}", file=sys.stderr)
        return proc.returncode or 1
    print(f"printer {name} enabled, uri {uri}")
    print(f"print with: lp -d {name} file.png")
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description="Add a CUPS queue for an Aimotech D30 / Print Master (lpadmin group)."
    )
    parser.add_argument(
        "--name", default=DEFAULT_NAME, help=f"queue name (default {DEFAULT_NAME})"
    )
    parser.add_argument("--mac", help="printer Bluetooth MAC (six hex octets)")
    parser.add_argument(
        "--list", action="store_true", help="list discovered D30-class devices"
    )
    parser.add_argument(
        "--dry-run", action="store_true", help="print lpadmin, do not change CUPS"
    )
    args = parser.parse_args(None if argv is None else argv[1:])
    if not args.name.replace(".", "").replace("_", "").replace("-", "").isalnum():
        print("aimotech-setup-printer: bad queue name", file=sys.stderr)
        return 2
    devices = discover()
    if args.list:
        if not devices:
            print("no D30-class BlueZ devices (power the printer, wait, retry)")
            return 0
        for addr, name in devices:
            print(f"aimotech://{addr}  {name}")
        return 0
    addr = None
    if args.mac:
        try:
            addr = aimotech_bt.parse_uri(f"aimotech://{args.mac}")
        except ValueError as exc:
            print(f"aimotech-setup-printer: {exc}", file=sys.stderr)
            return 2
    elif len(devices) == 1:
        addr = devices[0][0]
        print(f"using {devices[0][1]} {addr}", file=sys.stderr)
    elif not devices:
        print(
            "aimotech-setup-printer: no D30 found; pass --mac or power the printer",
            file=sys.stderr,
        )
        return 3
    else:
        print("aimotech-setup-printer: several devices, pass --mac:", file=sys.stderr)
        for dev_addr, name in devices:
            print(f"  aimotech://{dev_addr}  {name}", file=sys.stderr)
        return 3
    return add_queue(args.name, addr, dry_run=args.dry_run)


if __name__ == "__main__":
    sys.exit(main())
